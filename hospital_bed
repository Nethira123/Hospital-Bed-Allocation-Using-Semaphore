
#include <stdio.h>
#include <pthread.h>
#include <semaphore.h>
#include <unistd.h>

#define BEDS 3
#define PATIENTS 5

sem_t bed;
int available = BEDS;
pthread_mutex_t lock;

void* patient(void* arg)
{
    int id = *(int*)arg;

    sem_wait(&bed);

    pthread_mutex_lock(&lock);
    available--;
    printf("Patient %d admitted. Available beds: %d\n",
           id, available);
    pthread_mutex_unlock(&lock);

    sleep(2);

    pthread_mutex_lock(&lock);
    available++;
    printf("Patient %d discharged. Available beds: %d\n",
           id, available);
    pthread_mutex_unlock(&lock);

    sem_post(&bed);

    return NULL;
}

int main()
{
    pthread_t p[PATIENTS];
    int id[PATIENTS];

    sem_init(&bed, 0, BEDS);
    pthread_mutex_init(&lock, NULL);

    for(int i = 0; i < PATIENTS; i++)
    {
        id[i] = i + 1;
        pthread_create(&p[i], NULL, patient, &id[i]);
    }

    for(int i = 0; i < PATIENTS; i++)
        pthread_join(p[i], NULL);

    sem_destroy(&bed);
    pthread_mutex_destroy(&lock);

    return 0;
}
